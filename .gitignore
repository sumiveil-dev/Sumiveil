# ビルド成果物・ローカルの依存物 (scripts\env.ps1 / setup-tools.ps1 で再作成できる)
/target/
/.cargo-home/
/tools/
/dist/
# 開発時にダウンロードする元データ (scripts\gen-dict.ps1 / build-morph-dict.ps1 で再取得)
/data/raw/
# 公開リポジトリはビルドに必要な最小構成にする (以下は手元だけで使う)
